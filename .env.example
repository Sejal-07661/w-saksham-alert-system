# Copy this file to .env and fill in real values.
# .env itself is gitignored and should never be committed.

# --- Server ---
PORT=3000

# Restricts CORS to this origin in production. Defaults to
# http://localhost:3000 in code if unset — fine for local dev.
ALLOWED_ORIGIN=http://localhost:3000

# --- MongoDB ---
MONGO_URI=mongodb://localhost:27017/wsaksham_dev

# --- Redis (rate limiting, idempotency) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- RabbitMQ ---
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# --- Auth ---
# Generate a real one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Never use the literal value below outside local dev — the app will
# warn on startup if it detects the placeholder is still in use.
JWT_SECRET=changeme_dev_only

# --- AI risk scoring (Groq) ---
# Get a free key at https://console.groq.com
# If left blank, the app falls back to rule-based scoring automatically
# (ingestion is never blocked by an AI provider outage).
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# --- Email escalation (Gmail SMTP) ---
# GMAIL_APP_PASSWORD must be a Google "App Password", not your real
# account password. Generate one at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification enabled on the account).
# If left blank, the notification worker logs and skips sending (dev mode).
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- Geocoding (unused, kept for legacy compatibility) ---
GOOGLE_MAPS_API_KEY=

# --- Docker only ---
# Set automatically per-container in docker-compose.yml (app1/app2/app3).
# Leave as "local" for a single local instance.
INSTANCE_ID=local
